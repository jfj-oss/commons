{$COMMONS_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 26MB
	}
	# no access log: do not keep client IPs
	log {
		output discard
	}
	reverse_proxy relay:8787 {
		# long-poll sync waits up to 30 s
		transport http {
			read_timeout 60s
			response_header_timeout 60s
		}
	}
}

# Optional: LiveKit signalling behind the same style of TLS (only with the `calls` profile). Media itself does not pass
# through Caddy: it goes to the UDP/TCP ports in docs/DEPLOY.md.
{$COMMONS_LIVEKIT_DOMAIN:livekit.invalid} {
	log {
		output discard
	}
	reverse_proxy host.docker.internal:7880
}
