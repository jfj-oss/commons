+
+    /// mega patch L2: `set_key` moves the latest index to whatever slot it wrote, including a slot that is being
+    /// wiped. This puts it back to the index senders must use.
+    pub fn set_latest_key_index(&self, key_index: i32) {
+        self.latest_key_index.store(key_index, Ordering::Relaxed);
+    }
