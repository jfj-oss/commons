+void AudioTrack::set_volume(double volume) const {
+  // mega patch W1. RemoteAudioSource hands this to the voice engine, which
+  // scales the track's audio in the playout mix.
+  if (volume < 0.0) volume = 0.0;
+  if (volume > 10.0) volume = 10.0;
+  if (auto* source = track()->GetSource()) {
+    source->SetVolume(volume);
+  }
+}
