diff --git a/app/ui/bench.js b/app/ui/bench.js
new file mode 100644
index 0000000..62f077b
--- /dev/null
+++ b/app/ui/bench.js
@@ -0,0 +1,36 @@
+// Measurement only (app/gpui/bench/tauri-bench.patch): never part of a release. Does what MEGA_GPUI_* asks of mega-gpui, and writes the same marks.
+(async () => {
+  if (!window.__TAURI__) return;
+  const inv = (c, a) => window.__TAURI__.core.invoke(c, a);
+  const mark = (name, extra = {}) => inv('bench_mark', { line: JSON.stringify({ ...extra, mark: name, t: performance.timeOrigin + performance.now() }) }).catch(() => { });
+  const sleep = ms => new Promise(r => setTimeout(r, ms));
+  const until = async f => { for (;;) { let v; try { v = f(); } catch { } if (v) return v; await sleep(10); } };
+  const raf2 = () => new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
+  const cfg = await inv('bench_cfg');
+  requestAnimationFrame(() => mark('first_frame'));
+  await until(() => document.querySelector('#pp')); await raf2(); mark('signin_painted');
+  if (!cfg.pass) return;
+  document.querySelector('#pp').value = cfg.pass; document.querySelector('#go').click();
+  await until(() => S.snap); mark('unlocked');
+  if (!cfg.open) return;
+  const hit = await until(() => { for (const c of S.snap.communities) for (const ch of c.channels) if (ch.name === cfg.open && ch.joined) return { cid: c.id, gid: ch.gid }; });
+  await until(() => window.__mega && window.__mega.api && window.__mega.started);
+  window.__mega.api.toChat(hit.cid, hit.gid); mark('room_open');
+  await until(() => S.gid === hit.gid);
+  if (cfg.limit) { S.limit = cfg.limit; S.lastMsgs = ''; tick(); }
+  const want = cfg.limit || 1;
+  await until(() => S.gid === hit.gid && S.msgs && S.msgs.messages.length >= Math.min(want, 5000) - 0 && document.querySelectorAll('#stream .msg').length >= Math.min(S.msgs.messages.length, 1));
+  await until(() => document.querySelectorAll('#stream .msg').length >= S.msgs.messages.length * 0.9);
+  mark('room_loaded', { rows: S.msgs.messages.length, dom: document.querySelectorAll('#stream .msg').length });
+  await raf2(); mark('room_painted');
+  await sleep(cfg.settle || 1500);
+  if (cfg.frames) {
+    const st = document.querySelector('#stream'), top0 = st.scrollTop, f = []; let last = performance.now(); const end = last + cfg.frames * 1000;
+    mark('frames_start');
+    await new Promise(done => { const step = now => { f.push(now - last); last = now; if (now < end) requestAnimationFrame(step); else done(); }; requestAnimationFrame(step); });
+    f.shift(); f.sort((a, b) => a - b);
+    const q = p => f[Math.round((f.length - 1) * p)];
+    mark('frames_done', { rows: S.msgs.messages.length, scrolled_px: top0 - st.scrollTop, summary: { frames: f.length, mean: f.reduce((a, b) => a + b, 0) / f.length, p50: q(.5), p95: q(.95), p99: q(.99), max: f[f.length - 1], over_20ms: f.filter(x => x > 20).length, over_33ms: f.filter(x => x > 33.4).length } });
+  }
+  mark('auto_done');
+})();
