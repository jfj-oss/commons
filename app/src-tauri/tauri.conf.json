{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commons",
  "version": "0.1.0",
  "identifier": "app.commons.chat",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [ { "title": "Commons", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 520, "visible": true } ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "SocialNetworking"
  }
}
